# URL Base del backend de NestJS en Localhost
API_BASE_URL=http://localhost:3000

# Servicios del Backend
SERVICES_AUTH_URL=http://localhost:3000
SERVICES_ALERTS_URL=http://localhost:3000
SERVICES_MAPS_URL=http://localhost:3000
SERVICES_AID_URL=http://localhost:3000
SERVICES_USERS_URL=http://localhost:3000

# Servicios auxiliares
SERVICES_WEATHER_URL=http://localhost:3001
SERVICES_SEISMIC_URL=http://localhost:3002

# Autenticación: 'true' para modo desarrollo con usuario demo (sin requerir Keycloak Docker)
# Credenciales demo: usuario@correo.com / contraseña
USE_MOCK_AUTH=true

# MapTiler API Key para mapas vectoriales
MAPTILER_API_KEY=5SDHCuQINShPjv8AhcP8
